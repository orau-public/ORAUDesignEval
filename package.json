{
  "name": "ui-interviews",
  "version": "1.0.0",
  "description": "Repository with exercises for UI Designer candidates.",
  "license": "ISC",
  "author": "ORAU ITS-TS",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "css": "sass assets/scss/styles.scss assets/css/styles.css --style=expanded --source-map --quiet-deps --silence-deprecation=import,color-functions,global-builtin,if-function",
    "css:watch": "npm run css -- --watch",
    "build": "npm run css",
    "serve": "browser-sync start --server --port 3000 --files \"*.html\" \"assets/css/*.css\" \"assets/js/*.js\" --no-notify --ignore \"node_modules/**\"",
    "start": "npm-run-all build --parallel css:watch serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "browser-sync": "^3.0.4",
    "jquery": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.107.1"
  }
}
